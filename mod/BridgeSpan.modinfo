<?xml version='1.0' encoding='utf-8'?>
<Mod id="6fc747c1-f24b-4c0d-a4c2-91b84f99f762" version="51">
  <Properties>
    <Name>LOC_BS_MOD_NAME</Name>
    <Description>LOC_BS_MOD_DESCRIPTION</Description>
    <Authors>xuanda0201</Authors>
    <AffectsSavedGames>1</AffectsSavedGames>
    <CompatibleVersions>2.0</CompatibleVersions>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>0</SupportsMultiplayer>
    <SupportsHotSeat>0</SupportsHotSeat>
  </Properties>
  <ActionCriteria>
    <Criteria id="GS">
      <RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
    </Criteria>
    <Criteria id="GS_DetailedMapTacks">
      <RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
      <ModInUse>4ecfcc62-5471-4435-b295-590df213e8d8</ModInUse>
    </Criteria>
    <Criteria id="GS_MapSearchExtension">
      <RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
      <ModInUse>81423aeb-17fa-4b7b-ab73-0a25bfcb0e8c</ModInUse>
    </Criteria>
    <Criteria id="GS_Harmony">
      <RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
      <ModInUse>521b8777-0977-4859-a5ee-3e411a732e5c</ModInUse>
    </Criteria>
    <Criteria id="GS_BetterReportScreen">
      <RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
      <ModInUse>6f2888d4-79dc-415f-a8ff-f9d81d7afb53</ModInUse>
    </Criteria>
  </ActionCriteria>
  <LocalizedText>
    <Text id="LOC_BS_MOD_NAME">
      <en_US>BridgeSpan — Build Your Own Bridges</en_US>
      <zh_Hans_CN>自由造桥</zh_Hans_CN>
    </Text>
    <Text id="LOC_BS_MOD_DESCRIPTION">
      <en_US>Build one-tile stone bridges and two- or three-tile sea bridges. Land units, ships and trade routes use standard game movement. For Windows Steam Gathering Storm single-player, including Harmony in Diversity.</en_US>
      <zh_Hans_CN>建造1格石桥和2至3格跨海大桥。陆军、船只和商路均沿用游戏原版寻路。适用于 Windows Steam《风云变幻》单人游戏，可与《和而不同》搭配使用。</zh_Hans_CN>
    </Text>
  </LocalizedText>
  <InGameActions>
    <UpdateDatabase id="BS_Data" criteria="GS">
      <Properties>
        <LoadOrder>40000</LoadOrder>
      </Properties>
      <File>Districts.sql</File>
    </UpdateDatabase>
    <UpdateDatabase id="BS_Unlock" criteria="GS">
      <Properties>
        <LoadOrder>2000000</LoadOrder>
      </Properties>
      <File>Unlock.sql</File>
    </UpdateDatabase>
    <UpdateText id="BS_Text" criteria="GS">
      <Properties>
        <LoadOrder>40000</LoadOrder>
      </Properties>
      <File>Text.xml</File>
    </UpdateText>
    <UpdateIcons id="BS_Icons" criteria="GS">
      <Properties>
        <LoadOrder>40000</LoadOrder>
      </Properties>
      <File>Icons.sql</File>
    </UpdateIcons>
    <UpdateArt id="BS_Art" criteria="GS">
      <Properties>
        <LoadOrder>40000</LoadOrder>
      </Properties>
      <File>BridgeSpan.dep</File>
    </UpdateArt>
    <AddGameplayScripts id="BS_Gameplay" criteria="GS">
      <Properties>
        <LoadOrder>40000</LoadOrder>
      </Properties>
      <File>BridgeSpan_DistrictGameplay.lua</File>
    </AddGameplayScripts>
    <ImportFiles id="BS_Lua" criteria="GS">
      <Properties>
        <LoadOrder>40000</LoadOrder>
      </Properties>
      <File>BridgeSpan_DistrictCommon.lua</File>
      <File>WorldInput_BridgeSpan.lua</File>
      <File>ProductionPanel_BridgeSpan.lua</File>
      <File>MapPinPopup_BridgeSpan.lua</File>
      <File>MapSearchPanel_BridgeSpan.lua</File>
      <File>BS_VisibleBuildings.lua</File>
      <File>BS_PlotTooltip.lua</File>
      <File>BS_CityOverview.lua</File>
      <File>BS_ReportScreen.lua</File>
      <File>BS_BridgeDistricts22.dds</File>
      <File>BS_BridgeDistricts32.dds</File>
      <File>BS_BridgeDistricts38.dds</File>
      <File>BS_BridgeDistricts50.dds</File>
      <File>BS_BridgeDistricts80.dds</File>
      <File>BS_BridgeDistricts128.dds</File>
      <File>BS_BridgeDistricts256.dds</File>
    </ImportFiles>
    <ReplaceUIScript id="BS_WorldInput" criteria="GS">
      <Properties>
        <LoadOrder>40000</LoadOrder>
        <LuaContext>WorldInput</LuaContext>
        <LuaReplace>WorldInput_BridgeSpan.lua</LuaReplace>
      </Properties>
    </ReplaceUIScript>
    <!-- A third-party popup wins over the base adapter. Chain the known DMT
         popup immediately after its own replacement at load order 12345. -->
    <ReplaceUIScript id="BS_MapPinPopup" criteria="GS">
      <Properties>
        <LoadOrder>-1</LoadOrder>
        <LuaContext>MapPinPopup</LuaContext>
        <LuaReplace>MapPinPopup_BridgeSpan.lua</LuaReplace>
      </Properties>
    </ReplaceUIScript>
    <ReplaceUIScript id="BS_DetailedMapTacksPopup" criteria="GS_DetailedMapTacks">
      <Properties>
        <LoadOrder>12346</LoadOrder>
        <LuaContext>MapPinPopup</LuaContext>
        <LuaReplace>MapPinPopup_BridgeSpan.lua</LuaReplace>
      </Properties>
    </ReplaceUIScript>
    <ReplaceUIScript id="BS_ProductionPanel" criteria="GS">
      <Properties>
        <LoadOrder>160000</LoadOrder>
        <LuaContext>ProductionPanel</LuaContext>
        <LuaReplace>ProductionPanel_BridgeSpan.lua</LuaReplace>
      </Properties>
    </ReplaceUIScript>
    <ImportFiles id="BS_MapSearchExtension" criteria="GS_MapSearchExtension">
      <Properties>
        <LoadOrder>14101</LoadOrder>
      </Properties>
      <File>MseQuickWonders.lua</File>
    </ImportFiles>
    <ReplaceUIScript id="BS_PlotTooltip" criteria="GS">
      <Properties><LoadOrder>1</LoadOrder><LuaContext>PlotToolTip</LuaContext><LuaReplace>BS_PlotTooltip.lua</LuaReplace></Properties>
    </ReplaceUIScript>
    <ReplaceUIScript id="BS_CityOverview" criteria="GS">
      <Properties><LoadOrder>1</LoadOrder><LuaContext>CityPanelOverview</LuaContext><LuaReplace>BS_CityOverview.lua</LuaReplace></Properties>
    </ReplaceUIScript>
    <ReplaceUIScript id="BS_HDCityOverview" criteria="GS_Harmony">
      <Properties><LoadOrder>150001</LoadOrder><LuaContext>CityPanelOverview</LuaContext><LuaReplace>BS_CityOverview.lua</LuaReplace></Properties>
    </ReplaceUIScript>
    <ReplaceUIScript id="BS_ReportScreen" criteria="GS">
      <Properties><LoadOrder>1</LoadOrder><LuaContext>ReportScreen</LuaContext><LuaReplace>BS_ReportScreen.lua</LuaReplace></Properties>
    </ReplaceUIScript>
    <ReplaceUIScript id="BS_BetterReportScreen" criteria="GS_BetterReportScreen">
      <Properties><LoadOrder>1021</LoadOrder><LuaContext>ReportScreen</LuaContext><LuaReplace>BS_ReportScreen.lua</LuaReplace></Properties>
    </ReplaceUIScript>
    <UpdateDatabase id="BS_Worksites" criteria="GS">
      <Properties>
        <LoadOrder>2000001</LoadOrder>
      </Properties>
      <File>Worksites.sql</File>
    </UpdateDatabase>
    <UpdateIcons id="BS_WorksiteIcons" criteria="GS">
      <Properties>
        <LoadOrder>40001</LoadOrder>
      </Properties>
      <File>WorksiteIcons.sql</File>
    </UpdateIcons>
    <AddUserInterfaces id="BS_PlacementPicker" criteria="GS">
      <Properties>
        <Context>InGame</Context>
        <LoadOrder>41000</LoadOrder>
      </Properties>
      <File>BridgeSpan_PlacementPicker.xml</File>
    </AddUserInterfaces>
    <ImportFiles id="BS_PlacementPickerFiles" criteria="GS">
      <File>BridgeSpan_PlacementPicker.lua</File>
    </ImportFiles>
  </InGameActions>
